{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "functions": {
    "api/index.mjs": {
      "maxDuration": 300
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.mjs"
    },
    {
      "source": "/kra",
      "destination": "/index.html"
    },
    {
      "source": "/kra/(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/report",
      "destination": "/index.html"
    }
  ]
}
