PORT=8787
# Optional: server-only service account file. Share all workbooks with its client_email.
GOOGLE_APPLICATION_CREDENTIALS=
# Set the value above to an actual service-account JSON path if using private Sheets.
# Public read mode is enabled only for the explicit source workbooks in this brief.
ALLOW_PUBLIC_SHEETS=true
# Server-only OAuth fallback when a public Sheet request fails.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Server-only cloud persistence and GPT. Never prefix these keys with VITE_.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1

# Serverless deployment (Vercel). The service-account key travels as inline JSON because
# there is no credentials file to point GOOGLE_APPLICATION_CREDENTIALS at.
GOOGLE_CREDENTIALS_JSON=
# KRA access is covered by the application-wide Supabase session gate.

# Browser-safe Supabase project URL and publishable/anon key (never the service role key).
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=
# Optional comma-separated email allowlist. If empty, every authenticated account in this
# Supabase project can access the shared workspace and its data. Restrict signup if needed.
ATLAS_ALLOWED_EMAILS=
